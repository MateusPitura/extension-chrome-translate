{
  "expo": {
    "name": "app-reactnative-whatsapp",
    "slug": "app-reactnative-whatsapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appreactnativewhatsapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.appreactnativewhatsapp"
    },
    "plugins": [
