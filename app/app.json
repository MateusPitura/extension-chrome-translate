{
  "expo": {
    "name": "Chat Translator",
    "slug": "chat-translator",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chat-translator",
    "plugins": [["expo-share-intent", { "androidIntentFilters": ["audio/*", "application/ogg"] }]],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12161C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mateuspitura.chattranslator"
    },
    "ios": {
      "bundleIdentifier": "com.mateuspitura.chattranslator"
    },
    "extra": {
      "eas": {
        "projectId": "7e072dec-e2b2-4fe7-a6d1-1ae5081d3037"
      }
    }
  }
}
