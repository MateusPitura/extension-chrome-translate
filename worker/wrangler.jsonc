{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "messages-translator",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": "./public",
	},
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
}
